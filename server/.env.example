# Куда приходят заявки
BOOKING_EMAIL_TO=rustincohle@yandex.ru

# SMTP Яндекс (нужен пароль приложения: id.yandex.ru → Безопасность → Пароли приложений)
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=rustincohle@yandex.ru
SMTP_PASS=your_app_password_here

# Telegram — опционально (из РФ/Yandex Cloud часто не работает)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# VK — опционально (работает из РФ)
# Сообщество → Управление → Работа с API → ключ доступа (сообщения)
# VK_PEER_ID:
#   личка  — ваш id (vk.com/id123456789 → 123456789)
#   беседа — 2000000000 + chat_id (chat_id через messages.getConversations)
VK_ACCESS_TOKEN=
VK_PEER_ID=

ALLOWED_ORIGIN=http://localhost:5173,https://your-domain.ru
PORT=3001
